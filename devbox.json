{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    "shunit2@2.1.8",
    "shellcheck@latest",
    "jq@latest"
  ],
  "shell": {
    "scripts": {
      "test": "sh tests/run.sh",
      "lint": "shellcheck --external-sources scripts/*.sh && shellcheck --external-sources --shell sh tests/*.sh"
    }
  }
}
